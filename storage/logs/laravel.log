","abouts":"<pre class=sf-dump id=sf-dump-1554414457 data-indent-pad=\"  \"><span class=sf-dump-note>Illuminate\\Support\\Collection</span> {<a class=sf-dump-ref>#321</a><samp data-depth=1 class=sf-dump-expanded>
